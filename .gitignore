# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Entorno y editores
.env
.vscode/
.idea/
.DS_Store
Thumbs.db

# Espectros reales de NIST: son de la Coblentz Society y llevan copyright, asi
# que commitearlos en un repo publico seria redistribuirlos (decision de la
# seccion «Licencias» del plan; riesgo abierto n.o 4 de Requerimientos V3.1).
# Se reproducen con herramientas/descargar_espectros_nist.py y su manifiesto.
# Los archivos de prueba fabricados de datos/pruebas/ SI van versionados: no
# contienen datos de terceros.
datos/referencia/*
!datos/referencia/.gitkeep

# Pesos del modelo de MOD-06: mientras se itera no se suben (D-18). Se versiona
# un solo archivo final, red.npz, con su nota de licencia al lado.
motor_identificacion/modelo/*
!motor_identificacion/modelo/.gitkeep
!motor_identificacion/modelo/red.npz
!motor_identificacion/modelo/LEEME.md

# UT-03 · el archivo de parametros SI va versionado (D-6): la prueba antideriva
# y el arranque del backend dependen de que este en el repositorio.
!backend/utilerias/configuracion/parametros.json

# Nunca subir archivos de usuarios (RNF-09)
subidas/
tmp/

# Conjunto Chemotion IR (D-12 opcion B): CC BY-SA 4.0. Los espectros no se
# redistribuyen; lo que se versiona es el indice, los scripts y la nota de
# origen (datos/dataset/ORIGEN.md).
datos/dataset/espectros/
# Los vectores que deja T-16a-2 salen de esos espectros: tampoco se suben.
datos/dataset/vectores.npz
